<?xml version="1.0"?>
<!-- Top-level SO-101 description. Select the ros2_control backend with hw:=mock|gz|real -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101">

  <xacro:arg name="hw" default="mock"/>

  <xacro:include filename="$(find so101_description)/urdf/so101_arm.xacro"/>
  <xacro:include filename="$(find so101_description)/urdf/so101.ros2_control.xacro"/>

  <xacro:so101_ros2_control hw="$(arg hw)"/>

  <!-- Gazebo only: this plugin runs the controller manager inside the simulator and loads the
       controllers file the launch file passes in (the description does not depend on bringup). -->
  <xacro:arg name="gz_controllers" default=""/>
  <xacro:if value="${'$(arg hw)' == 'gz'}">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg gz_controllers)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>


</robot>
